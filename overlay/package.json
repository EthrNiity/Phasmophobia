{
  "name": "grimoire-overlay",
  "productName": "Grimoire Overlay",
  "version": "1.0.0",
  "description": "Le Grimoire des Entités dans une petite fenêtre au-dessus de Phasmophobia.",
  "author": "EthrNiity",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.ethrniity.grimoire-overlay",
    "productName": "Grimoire Overlay",
    "files": [
      "main.js",
      "preload.js",
      "hors-ligne.html",
      "icone.png",
      "icone-plateau.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icone.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Grimoire Overlay",
      "artifactName": "Grimoire-Overlay-${version}-installeur.${ext}"
    },
    "portable": {
      "artifactName": "Grimoire-Overlay-${version}-portable.exe"
    }
  }
}
